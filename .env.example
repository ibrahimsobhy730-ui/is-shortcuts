# Neon Postgres connection string — set in the Vercel project dashboard
# (Project → Settings → Environment Variables), never committed here.
# It comes from the Neon console: Project → Connection Details.
# It must include ?sslmode=require.
DATABASE_URL=postgresql://<user>:<password>@<host>/<database>?sslmode=require

# Optional: a different database for local verification runs.
# DATABASE_URL_LOCAL=
